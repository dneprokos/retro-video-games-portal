{
  "name": "retro-video-games-portal",
  "version": "1.0.0",
  "description": "A full-stack web application for managing and exploring retro video games",
  "main": "index.js",
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "server": "cd server && npm run dev",
    "client": "cd client && npm start",
    "install-all": "npm install && cd server && npm install && cd ../client && npm install",
    "build": "cd client && npm run build",
    "start": "cd server && npm start",
    "impact": "node .claude/skills/impact-analysis/scripts/analyze.js",
    "impact:test": "node --test .claude/skills/impact-analysis/scripts/impact.test.js",
    "scan": "node .claude/skills/static-defect-scan/scripts/scan.js",
    "scan:test": "node --test .claude/skills/static-defect-scan/scripts/scan.test.js",
    "bug": "node .claude/skills/jira-bug-creator/scripts/draft-bug.js",
    "bug:test": "node --test .claude/skills/jira-bug-creator/scripts/bug.test.js",
    "leakage": "node .claude/skills/jira-metrics-bug-leakage/scripts/leakage.js",
    "leakage:dashboard": "node .claude/skills/jira-metrics-bug-leakage/scripts/build-dashboard.js",
    "leakage:test": "node --test .claude/skills/jira-metrics-bug-leakage/scripts/leakage.test.js"
  },
  "keywords": [
    "retro",
    "video-games",
    "portal",
    "fullstack",
    "react",
    "nodejs"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^8.2.2",
    "msw": "^2.10.4"
  },
  "dependencies": {
    "bcrypt": "^6.0.0"
  }
}
